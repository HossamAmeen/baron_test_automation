# Copy to .env. Never commit .env.

# Targets (staging by default). Pointing at production is refused unless ALLOW_PRODUCTION=1.
BARON_WEB_URL=https://staging.baronlearning.com
BARON_API_URL=https://api.staging.baronlearning.com/

# An ACTIVE student account on the target environment. Leave empty to skip logged-in tests.
BARON_STUDENT_USERNAME=
BARON_STUDENT_PASSWORD=

# Optional: enables the authorized health-check test (endpoint allows 2 requests / 15 min).
BARON_HEALTH_API_KEY=

# Tests that create data on the target. Off by default.
# ALLOW_WRITES=1   -> registers one @mailinator.com account, sends one contact-us message
# ALLOW_CHECKOUT=1 -> starts (and resumes) one real XPay test-mode checkout for the student
ALLOW_WRITES=0
ALLOW_CHECKOUT=0
